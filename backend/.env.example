# Banco de Dados
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stocksnap?schema=public"

# JWT
# Gere uma chave aleatória com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O boot falha se este valor estiver ausente, com menos de 32 caracteres
# ou for um placeholder de exemplo.
JWT_SECRET="troque-por-uma-chave-secreta-forte-em-producao"
JWT_EXPIRATION="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
# Senha do Redis (obrigatória quando o servidor exige autenticação)
REDIS_PASSWORD="stocksnap123"

# App
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Seed (apenas dev/demo). Defina a senha do admin para evitar geração aleatória.
# SEED_ON_START="true"
# ADMIN_EMAIL="admin@stocksnap.com"
# ADMIN_PASSWORD="uma-senha-forte"
